# Базовый URL API (попадает в /app/build/config.json → getApiBase()).
API_BASE=http://localhost:5000/

# Базовый путь приложения (build-arg VITE_BASE). По умолчанию '/' — отдельный поддомен.
# Для деплоя под путём (например /hub) задайте VITE_BASE=/hub при сборке образа.
# VITE_BASE=

# URL remoteEntry.js каждого remote-приложения (build-args VITE_REMOTE_*).
# Задаются при сборке образа хаба, не в рантайме.
# VITE_REMOTE_CAMPAIGN=http://10.128.1.7/campaign/assets/remoteEntry.js
# VITE_REMOTE_GAME_SYSTEMS=http://10.128.1.7/game-systems/assets/remoteEntry.js
# VITE_REMOTE_PROFILE=http://10.128.1.7/profile/assets/remoteEntry.js
# VITE_REMOTE_LOGIN=http://10.128.1.7/login/assets/remoteEntry.js
