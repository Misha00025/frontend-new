# Базовый URL API (попадает в /app/build/config.json → getApiBase()).
API_BASE=http://localhost:5000/

# Базовый путь приложения (build-arg VITE_BASE). По умолчанию '/' — отдельный поддомен.
# Для деплоя под путём (например /game-systems) задайте VITE_BASE=/game-systems при сборке образа.
# VITE_BASE=
